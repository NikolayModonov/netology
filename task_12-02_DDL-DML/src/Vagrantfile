# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "debian/bookworm64"

  config.vm.provision "shell", inline: <<-SHELL
    set -e
    export DEBIAN_FRONTEND=noninteractive

    echo "====== Setup APT Cache ======"
    mkdir -p /vagrant/apt_cache
    echo 'Dir::Cache::archives "/vagrant/apt_cache/";' > /etc/apt/apt.conf.d/99-vagrant-cache

    echo "====== System Update ======"
    apt-get update -qq
    apt-get install -y -qq wget gnupg2 ca-certificates apt-transport-https sudo locales curl nano rsyslog netcat-openbsd unzip
    echo "Base packages installed"

    echo "====== Add MySQL 8.0 repository (correct key 2025) ======"
    # Remove old garbage
    rm -f /etc/apt/sources.list.d/mysql.list
    apt-key del B7B3B788A8D3785C 2>/dev/null || true
    rm -f /usr/share/keyrings/mysql.gpg

    # Download key 2025 and convert
    mkdir -p /usr/share/keyrings
    curl -fsSL https://repo.mysql.com/RPM-GPG-KEY-mysql-2025 | gpg --dearmor -o /usr/share/keyrings/mysql.gpg
    chmod 644 /usr/share/keyrings/mysql.gpg

    # Add repository with signed-by
    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/mysql.gpg] http://repo.mysql.com/apt/debian bookworm mysql-8.0" > /etc/apt/sources.list.d/mysql.list

    # Update and install
    apt-get clean
    apt-get update -qq

    # Pre-seed authentication plugin choice (legacy for compatibility)
    echo "mysql-server mysql-server/default-auth-override select Use Legacy Authentication Method (Retain MySQL 5.x Compatibility)" | debconf-set-selections

    apt-get install -y -qq mysql-server
    systemctl enable mysql
    systemctl start mysql
    echo "MySQL 8.0 installed and started"

    echo "====== TASK 1.2: Create user sys_temp ======"
    mysql -e "CREATE USER 'sys_temp'@'localhost' IDENTIFIED BY 'password';"
    echo "User sys_temp created"

    echo "====== TASK 1.3: Show users (screenshot) ======"
    echo "--- List of users ---"
    mysql -e "SELECT Host, User FROM mysql.user;"

    echo "====== TASK 1.4: Grant all privileges ======"
    mysql -e "GRANT ALL PRIVILEGES ON *.* TO 'sys_temp'@'localhost' WITH GRANT OPTION; FLUSH PRIVILEGES;"
    echo "All privileges granted to sys_temp"

    echo "====== TASK 1.5: Show privileges for sys_temp (screenshot) ======"
    echo "--- Grants for sys_temp ---"
    mysql -e "SHOW GRANTS FOR 'sys_temp'@'localhost';"

    echo "====== TASK 1.6: Change authentication plugin ======"
    mysql -e "ALTER USER 'sys_temp'@'localhost' IDENTIFIED WITH mysql_native_password BY 'password';"
    echo "Authentication plugin changed to mysql_native_password"

    echo "====== TASK 1.7: Download and restore Sakila dump ======"
    wget -q https://downloads.mysql.com/docs/sakila-db.zip -O /tmp/sakila-db.zip
    unzip -q /tmp/sakila-db.zip -d /tmp/
    mysql < /tmp/sakila-db/sakila-schema.sql
    mysql < /tmp/sakila-db/sakila-data.sql
    echo "Sakila database restored"

    echo "====== TASK 1.8: Show tables (screenshot) ======"
    echo "--- Tables in Sakila ---"
    mysql -e "USE sakila; SHOW TABLES;"

    echo "====== TASK 2: Show primary keys (screenshot) ======"
    echo "--- Primary keys of Sakila tables ---"
    mysql -e "USE sakila; SELECT TABLE_NAME, COLUMN_NAME FROM INFORMATION_SCHEMA.KEY_COLUMN_USAGE WHERE TABLE_SCHEMA = 'sakila' AND CONSTRAINT_NAME = 'PRIMARY' ORDER BY TABLE_NAME, ORDINAL_POSITION;"

    echo "====== All SQL commands saved to /vagrant/sql_commands.sql ======"
    cat > /vagrant/sql_commands.sql <<'SQL'
-- 1.2 Create user
CREATE USER 'sys_temp'@'localhost' IDENTIFIED BY 'password';

-- 1.3 Show users
SELECT Host, User FROM mysql.user;

-- 1.4 Grant all privileges
GRANT ALL PRIVILEGES ON *.* TO 'sys_temp'@'localhost' WITH GRANT OPTION;
FLUSH PRIVILEGES;

-- 1.5 Show grants
SHOW GRANTS FOR 'sys_temp'@'localhost';

-- 1.6 Change authentication
ALTER USER 'sys_temp'@'localhost' IDENTIFIED WITH mysql_native_password BY 'password';

-- 1.8 Show tables in Sakila
USE sakila;
SHOW TABLES;

-- 2 Primary keys
SELECT TABLE_NAME, COLUMN_NAME
FROM INFORMATION_SCHEMA.KEY_COLUMN_USAGE
WHERE TABLE_SCHEMA = 'sakila' AND CONSTRAINT_NAME = 'PRIMARY'
ORDER BY TABLE_NAME, ORDINAL_POSITION;
SQL

    echo "All done. Screenshots can be taken from the outputs above."
  SHELL

  config.vm.define "mysql-node" do |node|
    node.vm.hostname = "mysql-node"
    node.vm.network "private_network", ip: "10.10.10.20"
    node.vm.provider "virtualbox" do |vb|
      vb.gui = false
      vb.memory = 1024
      vb.cpus = 1
      vb.disk_size = "20GB"
      vb.name = "mysql-node"
    end
  end
end