# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "debian/bookworm64"
  config.vm.disk :disk, size: "10GB", primary: true

  $install_postgres = <<-SCRIPT
    set -e
    export DEBIAN_FRONTEND=noninteractive
    mkdir -p /vagrant/apt_cache 2>/dev/null
    echo 'Dir::Cache::archives "/vagrant/apt_cache/";' > /etc/apt/apt.conf.d/99-vagrant-cache
    apt-get update -qq >/dev/null 2>&1
    apt-get install -y -qq wget gnupg2 ca-certificates apt-transport-https sudo locales curl nano rsyslog netcat-openbsd >/dev/null 2>&1
    apt-get install -y -qq postgresql-common >/dev/null 2>&1
    /usr/share/postgresql-common/pgdg/apt.postgresql.org.sh -y -v 16 >/dev/null 2>&1
    apt-get update -qq >/dev/null 2>&1
    apt-get install -y -qq postgresql-16 postgresql-client-16 >/dev/null 2>&1
    systemctl enable postgresql 2>/dev/null
    systemctl start postgresql
  SCRIPT

  config.vm.define "pg-master" do |master|
    master.vm.hostname = "pg-master"
    master.vm.network "private_network", ip: "10.10.10.30"
    master.vm.provider "virtualbox" do |vb|
      vb.gui = false
      vb.memory = 1024
      vb.cpus = 1
      vb.name = "pg-master"
    end

    master.vm.provision "shell", inline: $install_postgres

    master.vm.provision "shell", inline: <<-SHELL
      echo "====== MASTER SETUP ======"
      cat >> /etc/postgresql/16/main/postgresql.conf <<EOF
listen_addresses = '*'
wal_level = replica
max_wal_senders = 10
wal_keep_size = 128MB
EOF
      cat >> /etc/postgresql/16/main/pg_hba.conf <<EOF
host    replication     replicator      10.10.10.31/32          md5
host    all             all             10.10.10.31/32          md5
EOF
      systemctl restart postgresql
      sudo -u postgres psql -c "CREATE USER replicator WITH REPLICATION LOGIN ENCRYPTED PASSWORD 'repl_pass';"
      sudo -u postgres psql -c "ALTER USER postgres WITH PASSWORD 'postgres';"

      echo "--- MASTER CONFIG (postgresql.conf) ---"
      grep -E "listen_addresses|wal_level|max_wal_senders|wal_keep_size" /etc/postgresql/16/main/postgresql.conf

      echo "--- MASTER PG_HBA ---"
      grep -E "replicator|10.10.10.31" /etc/postgresql/16/main/pg_hba.conf

      echo "--- REPLICATION USER ---"
      sudo -u postgres psql -c "\\du replicator"
    SHELL
  end

  config.vm.define "pg-slave" do |slave|
    slave.vm.hostname = "pg-slave"
    slave.vm.network "private_network", ip: "10.10.10.31"
    slave.vm.provider "virtualbox" do |vb|
      vb.gui = false
      vb.memory = 1024
      vb.cpus = 1
      vb.name = "pg-slave"
    end

    slave.vm.provision "shell", inline: $install_postgres

    slave.vm.provision "shell", inline: <<-SHELL
      echo "====== SLAVE SETUP ======"
      systemctl stop postgresql
      rm -rf /var/lib/postgresql/16/main/*

      sudo -u postgres bash -c 'cat > ~/.pgpass <<EOF
10.10.10.30:5432:*:replicator:repl_pass
EOF
      chmod 600 ~/.pgpass'

      sudo -u postgres pg_basebackup -h 10.10.10.30 -U replicator -D /var/lib/postgresql/16/main -Fp -Xs -P -R

      cat >> /etc/postgresql/16/main/postgresql.conf <<EOF
listen_addresses = '*'
wal_level = replica
max_wal_senders = 10
hot_standby = on
EOF
      systemctl start postgresql

      echo "--- SLAVE CONFIG (postgresql.conf) ---"
      grep -E "listen_addresses|wal_level|max_wal_senders|hot_standby" /etc/postgresql/16/main/postgresql.conf

      echo "--- REPLICATION STATUS (master side) ---"
      sleep 3
      sudo -u postgres psql -c "SELECT state, sync_state FROM pg_stat_replication;"

      echo "--- REPLICATION STATUS (slave side) ---"
      sudo -u postgres psql -c "SELECT status, sender_host FROM pg_stat_wal_receiver;"

      echo "--- CREATE TABLE ON MASTER VIA PSQL ---"
      export PGPASSWORD='postgres'
      psql -h 10.10.10.30 -U postgres -c "CREATE TABLE test (id int); INSERT INTO test VALUES (1),(2);"

      echo "--- CHECK DATA ON SLAVE ---"
      sleep 1
      sudo -u postgres psql -c "SELECT * FROM test;"
    SHELL
  end
end