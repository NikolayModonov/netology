# -*- mode: ruby -*-
# vi: set ft=ruby :

ENV['VAGRANT_EXPERIMENTAL'] = 'disks'
Vagrant.configure("2") do |config|
  config.vm.box = "debian/bookworm64"
  config.vm.hostname = "docker-host"
  
  config.vm.network "private_network", ip: "10.10.10.3"
  
  config.vm.disk :disk, size: "10GB", primary: true
  config.vm.provider "virtualbox" do |vb|
    vb.memory = "2048"
    vb.cpus = 2
  end

  config.vm.provision "shell", inline: <<-SHELL
    set -e
    export DEBIAN_FRONTEND=noninteractive
    
    mkdir -p /vagrant/apt_cache
    echo 'Dir::Cache::archives "/vagrant/apt_cache/";' > /etc/apt/apt.conf.d/99-vagrant-cache
    
    echo "==== Task 01. Install Docker and Build Image ===="
    apt-get update -qq > /dev/null
    apt-get install -y -qq ca-certificates curl gnupg lsb-release iproute2 > /dev/null
    mkdir -p /etc/apt/keyrings
    curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null
    apt-get update -qq > /dev/null
    apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-compose-plugin > /dev/null
    systemctl enable docker > /dev/null
    systemctl start docker
    echo "Docker installed successfully"

    mkdir -p /vagrant/docker_cache
    pull_and_cache() {
      image=$1
      docker images --format '{{.Repository}}:{{.Tag}}' | grep -q "^$image$" && return 0
      tar_path="/vagrant/docker_cache/$(echo "$image" | tr '/:' '_').tar"
      if [ -f "$tar_path" ]; then
        docker load -i "$tar_path" > /dev/null 2>&1
      else
        docker pull "$image" > /dev/null 2>&1
        docker save -o "$tar_path" "$image" > /dev/null 2>&1
      fi
    }

    pull_and_cache "nginx:latest"
    docker tag nginx:latest nginx:1.29.0
    pull_and_cache "centos:7"
    pull_and_cache "debian:latest"
    pull_and_cache "portainer/portainer-ce:latest"
    pull_and_cache "registry:2"

    mkdir -p /tmp/docker_task
    cat > /tmp/docker_task/index.html << 'EOF'
<html>
<head>
Hey, Netology
</head>
<body>
<h1>I will be DevOps Engineer!</h1>
</body>
</html>
EOF

    cat > /tmp/docker_task/Dockerfile << 'EOF'
FROM nginx:1.29.0
COPY index.html /usr/share/nginx/html/index.html
EOF

    cd /tmp/docker_task
    docker build -t custom-nginx:1.0.0 . > /dev/null 2>&1
    echo "custom-nginx:1.0.0 built successfully"

    echo "==== Task 02. Run custom-nginx ===="
    docker run -d --name ModonovNikolay-custom-nginx-t2 -p 127.0.0.1:8080:80 custom-nginx:1.0.0 > /dev/null
    docker rename ModonovNikolay-custom-nginx-t2 custom-nginx-t2
    date +"%d-%m-%Y %T.%N %Z" ; sleep 0.150 ; docker ps ; ss -tlpn | grep 127.0.0.1:8080 ; docker logs custom-nginx-t2 -n1 ; docker exec custom-nginx-t2 base64 /usr/share/nginx/html/index.html
    echo "# Verifying index page via curl on host port 8080:"
    curl -s http://127.0.0.1:8080 | head -n 1

    echo "==== Task 03. Container Management ===="
    echo "# Emulating Ctrl+C on docker attach..."
    docker kill --signal=SIGINT custom-nginx-t2
    sleep 2
    docker ps -a
    docker start custom-nginx-t2 > /dev/null
    echo "# Changing port 80 to 81..."
    docker exec custom-nginx-t2 sed -i -E 's/listen[[:space:]]+80;/listen 81;/g; s/listen[[:space:]]+\[::\]:80;/listen [::]:81;/g' /etc/nginx/conf.d/default.conf
    docker exec custom-nginx-t2 nginx -s reload
    sleep 3
    echo "# Curling port 80 (expected to fail):"
    docker exec custom-nginx-t2 curl -s http://127.0.0.1:80 || true
    echo "# Curling port 81 (expected to succeed):"
    docker exec custom-nginx-t2 curl -s http://127.0.0.1:81 || true
    echo "# Verifying host port mapping and force removing the running container:"
    ss -tlpn | grep 127.0.0.1:8080 || true
    docker port custom-nginx-t2
    curl -s http://127.0.0.1:8080 | head -n 1 || true
    docker rm -f custom-nginx-t2 > /dev/null

    echo "==== Task 04. Docker Volumes ===="
    mkdir -p /tmp/task4_dir && cd /tmp/task4_dir
    docker run -d --name centos1 -v /tmp/task4_dir:/data centos:7 sleep 3600 > /dev/null
    docker run -d --name debian1 -v /tmp/task4_dir:/data debian:latest sleep 3600 > /dev/null
    docker exec centos1 bash -c "echo 'Hello from CentOS container' > /data/centos_file.txt"
    echo "Hello from Host machine" > host_file.txt
    docker exec debian1 ls -la /data
    docker exec debian1 cat /data/centos_file.txt
    docker exec debian1 cat /data/host_file.txt
    docker rm -f centos1 debian1 > /dev/null

    echo "==== Task 05. Docker Compose (Part 1) ===="
    mkdir -p /tmp/netology/docker/task5 && cd /tmp/netology/docker/task5
    cat > compose.yaml << 'EOF'
version: "3"
services:
  portainer:
    network_mode: host
    image: portainer/portainer-ce:latest
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
EOF

    cat > docker-compose.yaml << 'EOF'
version: "3"
services:
  registry:
    image: registry:2
    ports:
    - "5000:5000"
EOF

    docker compose up -d
    echo ""
    echo "Explanation: 'compose.yaml' was executed because it is the default priority file for Docker Compose V2."
    echo ""
    
    cat > compose.yaml << 'EOF'
version: "3"
include:
  - docker-compose.yaml
services:
  portainer:
    network_mode: host
    image: portainer/portainer-ce:latest
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
EOF

    docker compose up -d
    docker tag custom-nginx:1.0.0 127.0.0.1:5000/custom-nginx:latest
    docker push 127.0.0.1:5000/custom-nginx:latest

    echo "==== Task 05. Waiting for Portainer ===="
    for i in $(seq 1 30); do
      curl -sk http://10.10.10.3:9000 > /dev/null 2>&1 && break
      sleep 5
    done
    echo "Portainer is ready."
    
    echo "==== Task 05. Portainer Web UI (Manual Action Required) ===="
    echo "1. Open http://10.10.10.3:9000 in your browser on the host machine."
    echo "2. Setup admin user/pass."
    echo "3. Go to Stacks -> Web editor and paste the required compose file."
    echo "4. Click Deploy."
    echo "5. Go to Containers -> inspect nginx container -> Config -> Screenshot from AppArmorProfile to Driver."
    echo ""
    echo "Return to Vagrant terminal and run 'vagrant ssh' then execute the final cleanup commands."
  SHELL
end
